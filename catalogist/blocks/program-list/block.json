{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "catalogist/program-list",
	"version": "1.0.0",
	"title": "Program List",
	"category": "catalogist",
	"icon": "list-view",
	"description": "Shows one of a program's lists: outcomes, careers, or industry certifications. Shows nothing, not even its heading, until the list has items.",
	"keywords": [ "outcomes", "careers", "jobs", "certifications", "learning outcomes" ],
	"textdomain": "catalogist",
	"usesContext": [ "postId", "postType" ],
	"attributes": {
		"list": { "type": "string", "enum": [ "outcomes", "careers", "certifications" ], "default": "outcomes" },
		"heading": { "type": "string", "default": "" },
		"headingLevel": { "type": "integer", "default": 2 }
	},
	"supports": {
		"html": false,
		"spacing": { "margin": true, "padding": true },
		"typography": { "fontSize": true }
	},
	"editorScript": "catalogist-blocks",
	"style": "catalogist-blocks",
	"render": "file:./render.php"
}
